{
  "manifest_version": 3,
  "name": "Hangout – Tambah Tempat",
  "short_name": "Hangout",
  "version": "0.2.0",
  "description": "Tambahkan tempat ke Hangout langsung dari post Instagram atau Google Maps — data terbaca otomatis, lengkap dengan pencarian alamat/titik.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Tambah ke Hangout",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "contextMenus"
  ],
  "host_permissions": [
    "https://maps.app.goo.gl/*",
    "https://goo.gl/*",
    "https://www.google.com/maps/*",
    "https://www.google.co.id/maps/*",
    "https://maps.google.com/*",
    "https://nominatim.openstreetmap.org/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.instagram.com/*",
        "https://www.google.com/maps/*",
        "https://www.google.co.id/maps/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "lib.js",
        "panel.js"
      ],
      "matches": [
        "https://www.instagram.com/*",
        "https://www.google.com/*",
        "https://www.google.co.id/*"
      ]
    }
  ]
}
